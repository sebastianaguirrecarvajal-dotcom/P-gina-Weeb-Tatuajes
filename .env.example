# Copia este archivo a `.env` y ajusta los valores.

# Base de datos (SQLite para desarrollo; sustituible por Postgres/MySQL en prod)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones del tatuador (JWT). Cambiar en producción.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales iniciales del tatuador (usadas por el seed).
ADMIN_EMAIL="tatuador@estudio.demo"
ADMIN_PASSWORD="cambia-esta-clave"

# URL pública del sitio (para metadatos SEO y enlaces absolutos).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
