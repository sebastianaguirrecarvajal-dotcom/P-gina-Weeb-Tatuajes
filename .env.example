# Copia este archivo a `.env` y ajusta los valores. NO versiones tu `.env`.

# -----------------------------------------------------------------------------
# Base de datos — PostgreSQL
# -----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
#
# Desarrollo local (ejemplo):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estudio?schema=public"
#
# Producción (Vercel + Postgres gestionado como Supabase / Neon):
#   - Usa la cadena "pooled" (PgBouncer) para la app en serverless, p. ej.:
#       DATABASE_URL="postgresql://USER:PASS@HOST:6543/db?pgbouncer=true&connection_limit=1"
#   - Y la cadena "direct" (sin pooler) para ejecutar migraciones:
#       DIRECT_URL="postgresql://USER:PASS@HOST:5432/db"
#     (DIRECT_URL es opcional; solo necesario si usas un pooler que no admite
#      sentencias DDL. Ver README.)
# En local, DATABASE_URL y DIRECT_URL pueden ser idénticas.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estudio?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/estudio?schema=public"

# -----------------------------------------------------------------------------
# Autenticación del tatuador (JWT en cookie httpOnly). Cambiar en producción.
# -----------------------------------------------------------------------------
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Credenciales iniciales del tatuador (usadas SOLO por el seed de demostración).
ADMIN_EMAIL="tatuador@estudio.demo"
ADMIN_PASSWORD="cambia-esta-clave"

# URL pública del sitio (para metadatos SEO y enlaces absolutos).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
